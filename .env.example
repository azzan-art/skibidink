# Copy to .env for a local run. Every value is optional.
PORT=3000
# DATABASE_URL=postgres://...
# EDGE_SECRET=        same value as the router Worker's EDGE_SECRET secret
# SITE_URL=https://skibidink.com
# ADMIN_PASSWORD=          at least 8 characters; unset closes /admin
# PRICE_PER_HOUR=          whole pesos; with both PayMongo secrets it turns on online payment
# PAYMONGO_SECRET_KEY=
# PAYMONGO_WEBHOOK_SECRET=
# MAIL_PROVIDER=brevo      or log (prints emails to the console); see knowledge/integ-mail.md
# BREVO_API_KEY=
# MAIL_FROM=
# DEMO_EMAIL=demo@skibidink.test   a verified demo customer, created on boot outside production
# DEMO_PASSWORD=
